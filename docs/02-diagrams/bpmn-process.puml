@startuml bpmn-process
title Бизнес-процесс TO-BE — Модуль 1 «ГИС Господдержка»
skinparam shadowing false
skinparam activity {
   BackgroundColor White
   BorderColor #455A64
   DiamondBackgroundColor #FFF8E1
   DiamondBorderColor #8D6E63
   FontName Arial
 }

|#E1F5FE|Заявитель (Предприятие)|
start
:Ввести ИНН организации;

|#FFF3E0|Портал / API Gateway|
:GET /api/v1/companies/suggest?inn=...;
:Проверка формата ИНН;

if (Формат ИНН корректен?) then (да)
  |#E8F5E9|Оркестратор и интеграции|
  :Проверить контрольное число ИНН;
  if (Контрольное число корректно?) then (да)
    :Запросить сведения ЕГРЮЛ;
    if (Сведения получены?) then (да)
      :Сохранить или обновить профиль COMPANIES по ИНН;
      |#FFF3E0|Портал / API Gateway|
      :Показать предзаполненные данные;
    else (нет)
      :Записать техническую ошибку;
      :Применить таймаут 10 с и не более 3 попыток;
      :Не считать ошибку отрицательным бизнес-результатом;
      stop
    endif
  else (нет)
    |#FFF3E0|Портал / API Gateway|
    :Вернуть 422 Validation Error;
    stop
  endif
else (нет)
  :Вернуть ошибку формата ИНН;
  stop
endif

|#E1F5FE|Заявитель (Предприятие)|
:Создать черновик;

|#FFF3E0|Портал / API Gateway|
:POST /api/v1/applications/drafts;

|#E8F5E9|Оркестратор и интеграции|
:Создать APPLICATIONS со статусом DRAFT;
:Записать статус в APPLICATION_STATUS_HISTORY;
:Записать событие в AUDIT_EVENTS;
:Сохранить ключ идемпотентности;

|#E1F5FE|Заявитель (Предприятие)|
:Заполнить данные проекта и контакты;

|#FFF3E0|Портал / API Gateway|
:PATCH /api/v1/applications/{id};

|#E8F5E9|Оркестратор и интеграции|
:Сохранить заявку и контактные данные;

|#E1F5FE|Заявитель (Предприятие)|
:Загрузить необходимые документы;

|#FFF3E0|Портал / API Gateway|
:POST /api/v1/applications/{id}/documents;

|#E8F5E9|Оркестратор и интеграции|
:Проверить статус заявки, полномочия, тип, размер и целостность файла;
if (Файл допустим?) then (да)
  :Сохранить файл в объектном хранилище;
  :Сохранить метаданные в APPLICATION_DOCUMENTS;
  :Записать событие загрузки в AUDIT_EVENTS;
else (нет)
  |#FFF3E0|Портал / API Gateway|
  :Вернуть 413 / 415 / 422;
  |#E1F5FE|Заявитель (Предприятие)|
  :Выбрать исправленный файл и повторить загрузку;
  stop
endif

|#E1F5FE|Заявитель (Предприятие)|
:Отправить заявку;

|#FFF3E0|Портал / API Gateway|
:POST /api/v1/applications/{id}/submit;
:Проверить обязательные поля и BR-VAL-01..03;

if (Валидация пройдена?) then (да)
  |#E8F5E9|Оркестратор и интеграции|
  :Перевести заявку DRAFT -> SUBMITTED;
  :Записать историю статуса и событие аудита;
  :Вернуть 202 Accepted;
  :Перевести заявку в DATA_CHECK;
  :Записать историю статуса и событие аудита;
else (нет)
  |#FFF3E0|Портал / API Gateway|
  :Вернуть 422 Validation Error;
  note right
    Черновик остаётся в DRAFT.
    Заявитель исправляет поля и отправляет повторно.
  end note
  stop
endif

|#E8F5E9|Оркестратор и интеграции|
:Проверить юридический статус и срок существования;
:Проверить налоговую задолженность;
:Проверить процедуры банкротства;
:Проверить РНП;
note right
  Каждая интеграция: timeout 10 с,
  максимум 3 попытки на операцию.
end note

if (Все обязательные проверки завершены?) then (да)
  :Сохранить успешные результаты в APPLICATION_CHECKS;
  :Сохранить финансовые показатели в COMPANY_FINANCIAL_SNAPSHOTS;
else (нет)
  :Сохранить ERROR в APPLICATION_CHECKS;
  :Записать событие аудита и уведомление;
  :Оставить заявку в DATA_CHECK;
  :Создать задачу восстановления после исчерпания попыток;
  :Не выполнять автоматическую четвёртую попытку;
  stop
endif

if (Обнаружен стоп-фактор?) then (да)
  #FFCDD2:Сохранить все выявленные основания;
  :Установить статус REJECTED;
  :Записать rejection_reason;
  :Записать историю статуса и аудит;
  :Создать уведомление в NOTIFICATION_OUTBOX;
  :Доставить уведомление заявителю;
  stop
else (нет)
  :Запросить скоринговую оценку;
endif

if (Скоринговый балл от 0 до 59?) then (да)
  #FFCDD2:Сохранить скоринг с рекомендацией REJECT;
  :Установить статус REJECTED;
  :Записать основание и историю статуса;
  :Создать уведомление;
  :Доставить уведомление заявителю;
  stop
elseif (Скоринговый балл 60-79?) then (да)
  :Сохранить скоринг с рекомендацией MANUAL_REVIEW;
  :Установить статус UNDER_REVIEW;
  :Записать историю статуса и аудит;
elseif (Скоринговый балл 80-100?) then (да)
  :Сохранить скоринг с рекомендацией APPROVE;
  :Установить статус UNDER_REVIEW;
  :Записать историю статуса и аудит;
else (Некорректный ответ)
  :Сохранить техническую ошибку скоринга;
  :Оставить заявку в DATA_CHECK;
  :Создать задачу восстановления скоринга;
  :Не выполнять автоматическую четвёртую попытку;
  stop
endif

|#F3E5F5|Оператор Минпромторга|
:Просмотреть заявку, проверки, документы и скоринг;
:Выбрать решение;

|#FFF3E0|Портал / API Gateway|
:POST /api/v1/applications/{id}/decision;

|#E8F5E9|Оркестратор и интеграции|
:Проверить права оператора и допустимость перехода;

if (Решение оператора?) then (Одобрить)
  :Записать DECISIONS (APPROVED);
  :Установить статус APPROVED;
  :Записать историю статуса и AUDIT_EVENTS;
  :Создать INTEGRATION_DELIVERIES для Модулей 2 и 3;
  :Создать уведомление в NOTIFICATION_OUTBOX;
  fork
    :Передать данные в Модуль 2;
    if (Модуль 2 подтвердил приём?) then (да)
      :Отметить доставку SENT;
    else (нет)
      :Сохранить ошибку и next_attempt_at;
      :RETRY_SCHEDULED, максимум 3 попытки;
    endif
  fork again
    :Передать финансовые условия в Модуль 3;
    if (Модуль 3 подтвердил приём?) then (да)
      :Отметить доставку SENT;
    else (нет)
      :Сохранить ошибку и next_attempt_at;
      :RETRY_SCHEDULED, максимум 3 попытки;
    endif
  end fork
  :Доставить уведомление заявителю;
  stop
elseif (Вернуть на доработку)
  :Записать DECISIONS (NEEDS_REVISION) и комментарий;
  :Установить статус NEEDS_REVISION;
  :Записать историю статуса и аудит;
  :Создать и доставить уведомление с замечаниями;
  |#E1F5FE|Заявитель (Предприятие)|
  :Исправить поля и документы;
  |#FFF3E0|Портал / API Gateway|
  :PATCH /api/v1/applications/{id};
  :POST /api/v1/applications/{id}/resubmit;
  |#E8F5E9|Оркестратор и интеграции|
  :Повторно проверить обязательные данные и документы;
  :Перевести статус NEEDS_REVISION -> SUBMITTED;
  :Сохранить историю статуса и аудит;
  :Запустить новый цикл проверок;
  stop
else (Отклонить)
  #FFCDD2:Записать DECISIONS (REJECTED) с основанием;
  :Установить статус REJECTED и rejection_reason;
  :Записать историю статуса и аудит;
  :Создать и доставить уведомление заявителю;
  stop
endif

@enduml
