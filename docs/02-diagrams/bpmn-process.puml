@startuml bpmn-process
title Бизнес-процесс TO-BE (Распределение господдержки)

|#E1F5FE|Заявитель (Предприятие)|
start
:Ввод ИНН организации;

|#FFF3E0|Портал / API Gateway|
:Запрос данных ЕГРЮЛ по ИНН;

|Заявитель (Предприятие)|
:Проверка предзаполненных данных;
:Заполнение параметров заявки и загрузка документов;
:Отправка заявки;

|Портал / API Gateway|
:Валидация обязательных полей;
if (Форма валидна?) then (да)
  |#E8F5E9|Оркестратор и Интеграции|
  :Сохранение заявки (SUBMITTED);
  :Перевод в статус DATA_CHECK;
else (нет)
  |Портал / API Gateway|
  :Возврат ошибок валидации заявителю;
  stop
endif

|#E8F5E9|Оркестратор и Интеграции|
:Проверка юридического статуса (ЕГРЮЛ);
:Проверка налоговой задолженности (ФНС);
:Проверка процедур банкротства (Федресурс);
:Проверка по РНП (ЕИС);

if (Проверки завершены успешно?) then (да)
else (нет)
  :Фиксация ошибки интеграции;
  :Повторный запрос или ожидание;
  stop
endif

if (Есть стоп-факторы?) then (да)
  #FFCDD2:Фиксация оснований отказа;
  :Присвоение статуса REJECTED;
  stop
else (нет)
  :Запрос скорингового балла;
endif

if (Скоринговый балл?) then (0-59)
  #FFCDD2:Фиксация результата скоринга;
  :Присвоение статуса REJECTED;
  stop
elseif (60-79)
  :Фиксация необходимости ручной проверки;
  |#F3E5F5|Оператор Минпромторга|
  :Просмотр заявки и результатов проверок;
elseif (80-100)
  :Фиксация рекомендации к одобрению;
  |#F3E5F5|Оператор Минпромторга|
  :Просмотр заявки и рекомендации скоринга;
else (Некорректный результат)
  |#E8F5E9|Оркестратор и Интеграции|
  :Фиксация ошибки скоринга;
  stop
endif

|#F3E5F5|Оператор Минпромторга|
if (Решение оператора?) then (Одобрить)
  #C8E6C9:Сохранение решения APPROVED;
  |#E8F5E9|Оркестратор и Интеграции|
  :Передача данных в Модуль 2;
  :Передача финансовых условий в Модуль 3;
  stop
elseif (Вернуть на доработку)
  |#E8F5E9|Оркестратор и Интеграции|
  :Сохранение замечаний оператора;
  :Присвоение статуса NEEDS_REVISION;
  |Заявитель (Предприятие)|
  :Исправление заявки;
  :Повторная отправка;
  stop
else (Отклонить)
  #FFCDD2:Сохранение решения REJECTED;
  stop
endif

@enduml