@startuml bpmn-process
title Бизнес-процесс TO-BE (Распределение господдержки)

|#E1F5FE|Заявитель (Предприятие)|
start
:Ввод ИНН организации;

|#FFF3E0|Портал / API Gateway|
:Запрос данных ЕГРЮЛ по ИНН;

|Заявитель (Предприятие)|
:Заполнение параметров заявки и загрузка проекта;
:Отправка заявки;

|Портал / API Gateway|
:Валидация полей (BR-VAL);
if (Форма валидна?) then (да)
else (нет)
  :Возврат ошибки;
  stop
endif

|#E8F5E9|Оркестратор и Интеграции|
:Сохранение заявки (SUBMITTED);
fork
  :Проверка задолженностей и банкротства (API ФНС);
fork again
  :Расчет финансового рейтинга (AI-скоринг);
end fork

if (Есть стоп-факторы?) then (да)
  #FFCDD2:Присвоение статуса REJECTED_AUTO;
  stop
else (нет)
endif

if (Score?) then (< 60)
  #FFCDD2:Присвоение статуса REJECTED_AUTO;
  stop
else (>= 60)
endif

|#F3E5F5|Оператор Минпромторга|
:Просмотр аналитического заключения на дашборде;
if (Решение оператора?) then (Одобрить)
  #C8E6C9:Утверждение заявки (APPROVED);
  stop
else (Отклонить)
  #FFCDD2:Отклонение заявки (REJECTED_MANUAL);
  stop
endif

@enduml